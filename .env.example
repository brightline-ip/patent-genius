# Patent Genius configuration. Nothing here is required for the offline core.
# Copy to .env if you like, but note that Patent Genius does not load .env itself: export these in your shell or in
# your MCP client's "env" block. Values below are placeholders.

# The ONE data folder: scope.json, inputs/, corpus/, public-originals/, locks/, the database. Default: a per-user folder
# (%LOCALAPPDATA%\Brightline\PatentGenius-Data on Windows). A folder inside the install folder is refused.
PG_TOOL_DATA_DIR=
# Extra folders from which the MCP/CLI may read .txt/.md office actions (absolute paths, separated by ; on Windows
# or : elsewhere). Default: <install>/examples and <data folder>/inputs.
PG_TOOL_INPUT_ROOTS=

# --- Optional Patent Research Hub integration (collecting USPTO data) ---
# Full path of the Patent Research Hub's Hub.cmd (Hub 0.2.0 or later). Patent Genius starts its gateway command for every
# provider call and never reads the Hub's keys.env. Unset = looked for in PG_HUB_ROOT, then the Hub installer's default folder.
PG_HUB_CMD=
# Install directory of the Patent Research Hub (Hub.cmd inside it).
PG_HUB_ROOT=
# 0 = do not look in the Hub installer's default folder.
PG_HUB_DISCOVER=
# Python executable used by scripts that start Python. Default: python3 (python on Windows).
PG_PYTHON=
# Regex of frame ids that must reserve every request in a ledger (PG_BUDGET_LEDGER). Default: off (see docs/FRAMES.md).
PG_BUDGET_FRAMES=

# --- Optional OCR ---
# Path to the tesseract executable. Default: first "tesseract" on PATH.
PG_TESSERACT=
