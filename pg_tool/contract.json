     "type": "array",
     "items": {
      "$ref": "#/$defs/PlanOutlineItem"
     }
    },
    "statistics": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/EvidenceCitation"
     }
    },
    "not_recognised": {
     "type": "object",
