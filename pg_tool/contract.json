{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:brightline-ip:patent-genius:tool-contract",
 "title": "Patent Genius tool contract",
 "contract_version": "1.1.0",
 "compatibility": "Additive changes (new optional input fields, new output fields, new enum values in outputs) keep the major version. Removing or renaming a field, tightening an input, or changing a meaning bumps the major version. Callers must ignore unknown output fields.",
 "limits": {
  "max_input_bytes": 2097152,
  "max_read_window_chars": 20000,
  "max_search_limit": 50,
  "max_report_chars": 200000,
  "excerpt_chars": 300,
  "local_timeout_s": 30,
  "tool_timeout_s": 240
 },
 "tools": {
  "pg_status": {
   "description": "Local dataset inventory, scope, database and Hub-command availability. No network; nothing is started.",
   "input": {
    "$ref": "#/$defs/StatusInput"
   },
   "output_data": {
    "$ref": "#/$defs/StatusData"
   },
   "schema_version": "1.0"
  },
  "pg_search": {
   "description": "Search the applications in your own frames (local-frames). Live provider search is planned and not part of 0.1.0; collect data from the command line instead (pg_cli.py collect).",
   "input": {
    "$ref": "#/$defs/SearchInput"
   },
   "output_data": {
    "$ref": "#/$defs/SearchData"
   },
   "schema_version": "1.0"
  },
  "pg_corpus": {
   "description": "List an application's locally normalized public file-wrapper documents, or read one document in character windows.",
   "input": {
    "$ref": "#/$defs/CorpusInput"
   },
   "output_data": {
    "$ref": "#/$defs/CorpusData"
   },
   "schema_version": "1.0"
  },
  "pg_trends": {
   "description": "Office-action rejection rates grouped by a dimension, using the strict rule (legalSectionCode + actionTypeCategory = rejected).",
   "input": {
    "$ref": "#/$defs/TrendsInput"
   },
   "output_data": {
    "$ref": "#/$defs/TrendsData"
   },
   "schema_version": "1.0"
  },
  "pg_post_grant": {
   "description": "PTAB trials, Federal Circuit opinions citing the patent, family links and prosecution rejections for one patent or application, from the data in your data folder. No provider call.",
   "input": {
    "$ref": "#/$defs/PostGrantInput"
   },
   "output_data": {
    "$ref": "#/$defs/PostGrantData"
   },
   "schema_version": "1.0"
  },
  "pg_template": {
   "description": "One structural document shell by key: section headings with bracketed prompts, review flags and the DRAFT header. No argument text and no statistics.",
   "input": {
    "$ref": "#/$defs/TemplateInput"
   },
   "output_data": {
    "$ref": "#/$defs/TemplateData"
   },
   "schema_version": "1.0"
  },
  "pg_assess_office_action": {
   "description": "Extract rejections, objections, restriction, finality and header facts from office-action text with fixed rules, and list the issues a response would need to address (candidate strategy labels and open questions; none is chosen). Adds rejection rates only when you built that data. No model is used.",
   "input": {
    "$ref": "#/$defs/AssessInput"
   },
   "output_data": {
    "$ref": "#/$defs/AssessData"
   },
   "schema_version": "1.0"
  },
  "pg_report": {
   "description": "Assemble a Markdown report (facts, statistics from your own data, issue outline, open questions, sources, limitations) for a practitioner or writer to work from.",
   "input": {
    "$ref": "#/$defs/ReportInput"
   },
   "output_data": {
    "$ref": "#/$defs/ReportData"
   },
   "schema_version": "1.0"
  },
  "pg_similar_office_actions": {
   "description": "Rank the office actions in your own database by a published weighted similarity (statutes, cited document numbers, examiner, art unit, classification, finality) and summarise where those matches ended up, with counts and 95% intervals, one case per patent family. Missing features score 0; open cases are reported separately; applicant steps are kept apart from outcomes. Similar by these features only; no model, no prediction. Transaction codes are checked against the USPTO PatEx 2022 list; which codes count as an interview, an abandonment and so on is the tool's own mapping (pg_tool/event_codes.json), and only actions anchored on their own mailing event (or, failing that, their own action event) are used; interview and amendment shares count only actions whose next event is recognised. Shares ignore open cases and favour quickly resolved ones; min_n is never below 5.",
   "input": {
    "$ref": "#/$defs/SimilarInput"
   },
   "output_data": {
    "$ref": "#/$defs/SimilarData"
   },
   "schema_version": "1.0"
  },
  "pg_response_pack": {
   "description": "Build a response material pack for one office action: typed facts, issues, authority pointers, art unit and examiner counts, a similar-action summary and a fact-filled shell. Every sentence is a fixed template with typed slots: it contains no tool-authored argument text, chooses no strategy and computes no deadline. Built in memory; nothing is written.",
   "input": {
    "$ref": "#/$defs/PackInput"
   },
   "output_data": {
    "$ref": "#/$defs/PackData"
   },
   "schema_version": "1.0"
  },
  "pg_db_report": {
   "description": "A named report from the database you built (overview, rejection rates, examiners, art units, coverage ...). Read-only; groups below min_n are left out; examiner filters match one exact name.",
   "input": {
    "$ref": "#/$defs/DbReportInput"
   },
   "output_data": {
    "$ref": "#/$defs/DbReportData"
   },
   "schema_version": "1.0"
  }
 },
 "$defs": {
  "AppNo": {
   "type": "string",
   "pattern": "^[0-9]{8}$"
  },
  "PatentNo": {
   "type": "string",
   "pattern": "^(RE|PP|D)?[0-9]{5,8}$"
  },
  "Statute": {
   "type": "string",
   "enum": [
    "101",
    "102",
    "103",
    "112",
    "double_patenting"
   ]
  },
  "Offsets": {
   "type": "array",
   "prefixItems": [
    {
     "type": "integer",
     "minimum": 0
    },
    {
     "type": "integer",
     "minimum": 0
    }
   ],
   "minItems": 2,
   "maxItems": 2
  },
  "Envelope": {
   "type": "object",
   "required": [
    "tool",
    "contract_version",
    "schema_version",
    "generated_at",
    "status",
    "data",
    "provenance",
    "caveats",
    "warnings",
    "disclaimer",
    "boundary",
    "interpretation"
   ],
   "properties": {
    "tool": {
     "type": "string"
    },
    "contract_version": {
     "type": "string"
    },
    "request_id": {
     "type": "string"
    },
    "matter_ref": {
     "type": "string"
    },
    "generated_at": {
     "type": "string",
     "format": "date-time"
    },
    "status": {
     "enum": [
      "ok",
      "partial",
      "not_found",
      "deferred",
      "error"
     ]
    },
    "data": {
     "type": "object"
    },
    "error": {
     "type": "object",
     "required": [
      "code",
      "message"
     ],
     "properties": {
      "code": {
       "enum": [
        "invalid_input",
        "not_found",
        "out_of_scope_path",
        "too_large",
        "timeout",
        "internal"
       ]
      },
      "message": {
       "type": "string",
       "description": "Never contains caller-supplied text."
      }
     }
    },
    "provenance": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "kind",
       "ref"
      ],
      "properties": {
       "kind": {
        "enum": [
         "local",
         "corpus",
         "caller",
         "template",
         "derived"
        ]
       },
       "ref": {
        "type": "string"
       },
       "sha256": {
        "type": "string"
       },
       "retrieved_at": {
        "type": "string"
       },
       "note": {
        "type": "string"
       }
      }
     }
    },
    "caveats": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "warnings": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "disclaimer": {
     "const": "Drafting and research aid for a registered practitioner. Not legal advice."
    },
    "boundary": {
     "type": "object",
     "required": [
      "lane",
      "classification",
      "persisted_by_tool",
      "hub_store",
      "model_used",
      "live_calls"
     ],
     "properties": {
      "lane": {
       "enum": [
        "public",
        "caller-supplied"
       ]
      },
      "classification": {
       "enum": [
        "public",
        "caller-confidential"
       ],
       "description": "caller-confidential = caller-supplied material (e.g. a client office action); processed in memory, never persisted by the tool, and never to be added to public shared corpora."
      },
      "persisted_by_tool": {
       "const": false
      },
      "hub_store": {
       "type": "boolean",
       "description": "Always false: no tool stores anything in a Hub database."
      },
      "model_used": {
       "const": false
      },
      "live_calls": {
       "type": "integer",
       "minimum": 0
      },
      "note": {
       "type": "string"
      },
      "matter": {
       "enum": [
        "client",
        null
       ]
      }
     }
    },
    "interpretation": {
     "type": "object",
     "required": [
      "status",
      "label"
     ],
     "properties": {
      "status": {
       "enum": [
        "not_requested",
        "unavailable",
        "provided"
       ]
      },
      "label": {
       "type": "string"
      },
      "model": {
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     }
    },
    "schema_version": {
     "type": "string"
    }
   }
  },
  "StatusInput": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "request_id": {
     "type": "string",
     "maxLength": 80
    },
    "matter_ref": {
     "type": "string",
     "maxLength": 80
    }
   }
  },
  "StatusData": {
   "type": "object",
   "required": [
    "datasets",
    "templates",
    "live"
   ],
   "properties": {
    "datasets": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "name",
       "path",
       "present"
      ],
      "properties": {
       "name": {
        "type": "string"
       },
       "path": {
        "type": "string"
       },
       "present": {
        "type": "boolean"
       },
       "bytes": {
        "type": "integer"
       },
       "modified": {
        "type": "string"
       },
       "detail": {
        "type": "string"
       }
      }
     }
    },
    "templates": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "live": {
     "type": "object",
     "properties": {
      "enabled": {
       "type": "boolean"
      },
      "hub_present": {
       "type": "boolean"
      },
      "usptolock": {
       "type": "string"
      }
     }
    },
    "parser": {
     "type": "object"
    }
   }
  },
  "SearchInput": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "source"
   ],
   "properties": {
    "request_id": {
     "type": "string"
    },
    "matter_ref": {
     "type": "string"
    },
    "source": {
     "enum": [
      "local-frames"
     ],
     "description": "Only local-frames in 0.1.0: your own frames, no provider call. Live provider search is planned."
    },
    "query": {
     "type": "string",
     "maxLength": 500,
     "description": "Text query. For local-frames: matched against applicant and CPC symbols."
    },
    "application_number": {
     "$ref": "#/$defs/AppNo"
    },
    "patent_number": {
     "$ref": "#/$defs/PatentNo"
    },
    "cpc": {
     "type": "string",
     "pattern": "^[A-HY][0-9]{2}[A-Z]([0-9]{1,4}(/[0-9]{1,6})?)?$"
    },
    "art_unit": {
     "type": "string",
     "pattern": "^[0-9]{4}$"
    },
    "stratum": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]{0,31}$",
     "description": "A field name defined in your scope.json (lower case, digits, underscores)."
    },
    "filing_year": {
     "type": "integer",
     "minimum": 1976,
     "maximum": 2100
    },
    "limit": {
     "type": "integer",
     "minimum": 1,
     "maximum": 50,
     "default": 20
    },
    "cursor": {
     "type": "string",
     "maxLength": 200
    }
   }
  },
  "SearchData": {
   "type": "object",
   "required": [
    "source",
    "results",
    "complete"
   ],
   "properties": {
    "source": {
     "type": "string"
    },
    "results": {
     "type": "array",
     "items": {
      "type": "object"
     }
    },
    "total_reported": {
     "type": [
      "integer",
      "null"
     ],
     "description": "Count the source reported; not a population size."
    },
    "next_cursor": {
     "type": [
      "string",
      "null"
     ]
    },
    "complete": {
     "type": "boolean",
     "description": "True only when every matching local row was returned; live searches are never marked complete."
    }
   }
  },
  "CorpusInput": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "application_number"
   ],
   "properties": {
    "request_id": {
     "type": "string"
    },
    "matter_ref": {
     "type": "string"
    },
    "application_number": {
     "$ref": "#/$defs/AppNo"
    },
    "document_id": {
     "type": "string",
     "pattern": "^[A-Za-z0-9-]{6,64}$"
    },
    "offset": {
     "type": "integer",
     "minimum": 0,
     "default": 0
    },
    "max_chars": {
     "type": "integer",
     "minimum": 500,
     "maximum": 20000,
     "default": 8000
    },
    "document_codes": {
     "type": "array",
     "items": {
      "type": "string",
      "maxLength": 10
     }
    }
   }
  },
  "CorpusData": {
   "type": "object",
   "required": [
    "application_number"
   ],
   "properties": {
    "application_number": {
     "type": "string"
    },
    "documents": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "document_id",
       "code"
      ],
      "properties": {
       "document_id": {
        "type": "string"
       },
       "code": {
        "type": "string"
       },
       "component": {
        "type": [
         "string",
         "null"
        ]
       },
       "official_date": {
        "type": [
         "string",
         "null"
        ]
       },
       "text_fidelity": {
        "type": [
         "string",
         "null"
        ]
       },
       "markdown_sha256": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     }
    },
    "document": {
     "type": "object",
     "properties": {
      "document_id": {
       "type": "string"
      },
      "code": {
       "type": "string"
      },
      "metadata": {
       "type": "object"
      },
      "text": {
       "type": "string"
      },
      "offset": {
       "type": "integer"
      },
      "next_offset": {
       "type": [
        "integer",
        "null"
       ]
      },
      "total_chars": {
       "type": "integer"
      }
     }
    }
   }
  },
  "TrendsInput": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "group_by"
   ],
   "properties": {
    "request_id": {
     "type": "string"
    },
    "matter_ref": {
     "type": "string"
    },
    "group_by": {
     "enum": [
      "stratum",
      "cpc_group",
      "cpc_subclass",
      "art_unit",
      "filing_year",
      "oa_year",
      "oa_kind"
     ]
    },
    "filters": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "stratum": {
       "type": "string",
       "pattern": "^[a-z][a-z0-9_]{0,31}$",
       "description": "A field name defined in your scope.json (lower case, digits, underscores)."
      },
      "cpc_prefix": {
       "type": "string",
       "pattern": "^[A-HY][0-9A-Z/]{0,15}$"
      },
      "art_unit": {
       "type": "string",
       "pattern": "^[0-9]{4}$"
      },
      "filing_year": {
       "type": "integer"
      },
      "oa_kind": {
       "enum": [
        "CTNF",
        "CTFR"
       ]
      }
     }
    },
    "groups": {
     "type": "array",
     "items": {
      "type": "string",
      "maxLength": 20
     },
     "maxItems": 50,
     "description": "Return only these group values."
    },
    "min_n": {
     "type": "integer",
     "minimum": 5,
     "description": "Smallest group shown. Default: 5 for stratum/filing_year, 200 for cpc_group/cpc_subclass/art_unit, 100 for oa_year/oa_kind. Never below 5."
    },
    "limit": {
     "type": "integer",
     "minimum": 1,
     "maximum": 200,
     "default": 50
    }
   }
  },
  "TrendsData": {
   "type": "object",
   "required": [
    "unit",
    "rule",
    "frames",
    "rows"
   ],
   "properties": {
    "unit": {
     "enum": [
      "application",
      "office_action"
     ]
    },
    "rule": {
     "type": "string"
    },
    "frames": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "denominator_note": {
     "type": "string"
    },
    "rows": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "group",
       "n"
      ],
      "properties": {
       "group": {
        "type": "string"
       },
       "n": {
        "type": "integer"
       },
       "rates": {
        "type": "object",
        "additionalProperties": {
         "type": "number",
         "minimum": 0,
         "maximum": 1
        }
       },
       "counts": {
        "type": "object",
        "additionalProperties": {
         "type": "integer"
        }
       }
      }
     }
    },
    "suppressed_groups": {
     "type": "integer",
     "description": "Groups below min_n not shown."
    },
    "min_n": {
     "type": "integer"
    },
    "truncated": {
     "type": "boolean"
    }
   }
  },
  "PostGrantInput": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "request_id": {
     "type": "string"
    },
    "matter_ref": {
     "type": "string"
    },
    "patent_number": {
     "$ref": "#/$defs/PatentNo"
    },
    "application_number": {
     "$ref": "#/$defs/AppNo"
    }
   },
   "oneOf": [
    {
     "required": [
      "patent_number"
     ]
    },
    {
     "required": [
      "application_number"
     ]
    }
   ]
  },
  "PostGrantData": {
   "type": "object",
   "required": [
    "patent_number",
    "application_number",
    "ptab_trials",
    "federal_circuit",
    "coverage"
   ],
   "properties": {
    "patent_number": {
     "type": [
      "string",
      "null"
     ]
    },
    "application_number": {
     "type": [
      "string",
      "null"
     ]
    },
    "ptab_trials": {
     "type": "array",
     "items": {
      "type": "object"
     }
    },
    "ptab_appeals": {
     "type": "array",
     "items": {
      "type": "object"
     }
    },
    "federal_circuit": {
     "type": "array",
     "items": {
      "type": "object"
     }
    },
    "family": {
     "type": [
      "object",
      "null"
     ]
    },
    "prosecution_rejections": {
     "type": [
      "array",
      "null"
     ],
     "items": {
      "type": "string"
     }
    },
    "coverage": {
     "type": "object",
     "description": "Which local datasets were searched, their snapshot dates, and known gaps (absence of a record is not proof of absence)."
    },
    "prosecution_actions": {
     "type": [
      "array",
      "null"
     ]
    },
    "frame_row": {
     "type": [
      "object",
      "null"
     ]
    }
   }
  },
  "TemplateInput": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "key"
   ],
   "properties": {
    "request_id": {
     "type": "string"
    },
    "matter_ref": {
     "type": "string"
    },
    "key": {
     "enum": [
      "office-action-response",
      "restriction-election",
      "oa-issue-inventory",
      "interview-notes",
      "client-update",
      "invention-intake",
      "application",
      "summary"
     ]
    },
    "include_markdown": {
     "type": "boolean",
     "default": true
    },
    "sections": {
     "type": "array",
     "items": {
      "type": "string",
      "maxLength": 20
     },
     "description": "Section numbers to return (e.g. '0', '3.1'); default all."
    }
   }
  },
  "TemplateData": {
   "type": "object",
   "required": [
    "key",
    "template_id",
    "path",
    "sha256",
    "title",
    "kind",
    "sections",
    "evidence_tables",
    "caveats",
    "evidence_sources"
   ],
   "properties": {
    "key": {
     "type": "string"
    },
    "path": {
     "type": "string"
    },
    "sha256": {
     "type": "string"
    },
    "title": {
     "type": "string"
    },
    "kind": {
     "enum": [
      "evidence-informed",
      "structural-shell"
     ]
    },
    "anchor": {
     "type": [
      "string",
      "null"
     ],
     "description": "Section the key maps to inside a shared template (e.g. rce -> section 3)."
    },
    "markdown": {
     "type": "string"
    },
    "sections": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "number",
       "heading",
       "level",
       "offsets"
      ],
      "properties": {
       "number": {
        "type": [
         "string",
         "null"
        ]
       },
       "heading": {
        "type": "string"
       },
       "level": {
        "type": "integer"
       },
       "offsets": {
