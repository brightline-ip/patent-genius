     "description": "Shaped by schemas/office-action-analysis.schema.json (schema_version 1.0, provenance.method rule_extracted, human_verified false). See schema_conformance.",
     "type": "object"
    },
    "parser_annotations": {
     "type": "object",
     "description": "Keyed by finding id (R1, O1, restriction, allowable_subject_matter): pattern_id, basis (form_paragraph|phrase|heading_only), confidence (pattern|heading_only|ambiguous), status_hint, ground, section, claims_text, repeats, excerpt (only with include_excerpts)."
    },
    "schema_conformance": {
     "type": "object",
     "properties": {
      "schema": {
       "type": "string"
      },
      "checked": {
       "type": "boolean"
